{
  "manifest_version": 2,
  "name": "Fire Axolotl · Aion",
  "version": "0.1.0",
  "description": "Containers, video controls, captions and translation with explicit consent.",
  "default_locale": "tr",
  "browser_specific_settings": {
    "gecko": {
      "id": "aion@fire-axolotl.browser",
      "strict_min_version": "140.0"
    }
  },
  "permissions": ["activeTab", "storage", "contextualIdentities", "cookies"],
  "optional_permissions": ["https://*/*"],
  "background": {"scripts": ["shared.js", "background.js"], "persistent": false},
  "browser_action": {
    "default_area": "navbar",
    "default_title": "Fire Axolotl · Aion",
    "default_popup": "popup.html",
    "default_icon": {"32": "icons/32.png", "64": "icons/64.png"}
  },
  "icons": {"48": "icons/48.png", "96": "icons/96.png"},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
